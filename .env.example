APP_ENV=dev
APP_NAME=bAutoCV API
APP_DESCRIPTION=Backend service for CV automation workflows.
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://autocv.me

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bautocv
DATABASE_ECHO=false

RENDERCV_ENABLED=false
RENDERCV_BIN=rendercv
RENDERCV_OUTPUT_DIR=generated_cvs
