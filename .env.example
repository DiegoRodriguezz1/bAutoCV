APP_ENV=dev
APP_NAME=bAutoCV API
APP_DESCRIPTION=Backend service for CV automation workflows.
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://autocv.me

# Se puede pegar tal cual la URL de Render/Neon/Supabase (postgresql://...?sslmode=require).
# Copia este archivo como .env.dev y .env.prod; esos dos no se suben al repo.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bautocv
DATABASE_ECHO=false

RENDERCV_ENABLED=false
RENDERCV_BIN=rendercv
RENDERCV_OUTPUT_DIR=generated_cvs

# Experimento A/B
# true solo en desarrollo: permite forzar el grupo A/B al crear la sesión
EXPERIMENT_ALLOW_FORCED_GROUP=false
# Si tiene valor, la consola del investigador debe enviar el header X-Research-Key
RESEARCH_API_KEY=
ESCO_SELECTED_VERSION=v1.2.0
